#!/usr/bin/env python3
import argparse
import json
import os
import subprocess
import sys
import tempfile
import uuid
from pathlib import Path

import requests


HOME = Path.home()
DEFAULT_ACCOUNT = os.environ.get("GOG_ACCOUNT", "zhihong@gmail.com")
DEFAULT_CLIENT = os.environ.get("GOG_PHOTOS_CLIENT", "photos")
GOG = os.environ.get("GOG_BIN", str(HOME / ".openclaw/bin/gog"))
TOKEN_URL = "https://oauth2.googleapis.com/token"
PICKER_URL = "https://photospicker.googleapis.com/v1"


def load_env_file(path):
    env = os.environ.copy()
    try:
        for line in Path(path).read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            env.setdefault(key.strip(), value.strip().strip("'\""))
    except FileNotFoundError:
        pass
    return env


def export_refresh_token(account, client):
    env = load_env_file(HOME / ".config/gogcli/keyring.env")
    with tempfile.NamedTemporaryFile(delete=False) as handle:
        token_path = handle.name
    try:
        subprocess.run(
            [
                GOG,
                "auth",
                "tokens",
                "export",
                account,
                "--client",
                client,
                "--out",
                token_path,
                "--overwrite",
                "--no-input",
            ],
            env=env,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=True,
        )
        return json.loads(Path(token_path).read_text())["refresh_token"]
    finally:
        try:
            os.remove(token_path)
        except FileNotFoundError:
            pass


def load_credentials(client):
    client_path = HOME / f".config/gogcli/credentials-{client}.json"
    default_path = HOME / ".config/gogcli/credentials.json"
    path = client_path if client_path.exists() else default_path
    data = json.loads(path.read_text())
    return data["client_id"], data["client_secret"]


def access_token(account, client):
    client_id, client_secret = load_credentials(client)
    refresh_token = export_refresh_token(account, client)
    response = requests.post(
        TOKEN_URL,
        data={
            "client_id": client_id,
            "client_secret": client_secret,
            "refresh_token": refresh_token,
            "grant_type": "refresh_token",
        },
        timeout=30,
    )
    if response.status_code >= 400:
        raise SystemExit(f"token refresh failed: {response.status_code} {response.text}")
    return response.json()["access_token"]


def request_json(method, path, account, client, **kwargs):
    token = access_token(account, client)
    headers = kwargs.pop("headers", {})
    headers["Authorization"] = f"Bearer {token}"
    response = requests.request(
        method,
        f"{PICKER_URL}{path}",
        headers=headers,
        timeout=30,
        **kwargs,
    )
    if response.status_code >= 400:
        raise SystemExit(f"request failed: {response.status_code} {response.text}")
    if response.content:
        return response.json()
    return {}


def print_json(data):
    print(json.dumps(data, ensure_ascii=False, indent=2))


def cmd_create(args):
    body = {}
    if args.max_items is not None:
        body["pickingConfig"] = {"maxItemCount": str(args.max_items)}
    data = request_json(
        "POST",
        "/sessions",
        args.account,
        args.client,
        params={"requestId": str(uuid.uuid4())},
        json=body,
    )
    if args.json:
        print_json(data)
    else:
        print(f"id\t{data.get('id', '')}")
        print(f"pickerUri\t{data.get('pickerUri', '')}")
        print(f"expireTime\t{data.get('expireTime', '')}")


def cmd_get(args):
    print_json(request_json("GET", f"/sessions/{args.session_id}", args.account, args.client))


def cmd_delete(args):
    request_json("DELETE", f"/sessions/{args.session_id}", args.account, args.client)
    print(f"deleted\t{args.session_id}")


def cmd_list(args):
    params = {"sessionId": args.session_id, "pageSize": args.page_size}
    if args.page_token:
        params["pageToken"] = args.page_token
    print_json(request_json("GET", "/mediaItems", args.account, args.client, params=params))


def cmd_check(args):
    data = request_json(
        "POST",
        "/sessions",
        args.account,
        args.client,
        params={"requestId": str(uuid.uuid4())},
        json={"pickingConfig": {"maxItemCount": "1"}},
    )
    session_id = data.get("id")
    if session_id:
        request_json("DELETE", f"/sessions/{session_id}", args.account, args.client)
    print("ok\tGoogle Photos Picker connection verified")


def main():
    parser = argparse.ArgumentParser(description="Google Photos Picker API helper")
    parser.add_argument("--account", default=DEFAULT_ACCOUNT)
    parser.add_argument("--client", default=DEFAULT_CLIENT)
    subparsers = parser.add_subparsers(dest="command", required=True)

    create = subparsers.add_parser("create-session")
    create.add_argument("--max-items", type=int)
    create.add_argument("--json", action="store_true")
    create.set_defaults(func=cmd_create)

    get = subparsers.add_parser("get-session")
    get.add_argument("session_id")
    get.set_defaults(func=cmd_get)

    delete = subparsers.add_parser("delete-session")
    delete.add_argument("session_id")
    delete.set_defaults(func=cmd_delete)

    media = subparsers.add_parser("list-media")
    media.add_argument("session_id")
    media.add_argument("--page-size", type=int, default=50)
    media.add_argument("--page-token")
    media.set_defaults(func=cmd_list)

    check = subparsers.add_parser("check")
    check.set_defaults(func=cmd_check)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
